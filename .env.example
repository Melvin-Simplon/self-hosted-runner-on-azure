# Copy to .env (never committed, see .gitignore) and fill in. These are the only values to set.
# A variable already set in the environment wins over this file: the CI passes its own.

# Existing Azure resource group that hosts the runner. Terraform only reads it, never creates it.
AZURE_RESOURCE_GROUP=

# HCP Terraform organization holding the state (workspaces runnerbootstrap and runnerdev).
TF_CLOUD_ORGANIZATION=

# Where the runner registers:
#   https://github.com/<org>             every repository of the organization can use it
#   https://github.com/<owner>/<repo>    this repository only
# GitHub has no runner for a whole personal account: for personal repositories, pick one repository.
GITHUB_RUNNER_URL=

# Fine-grained PAT, short expiry, used only to request the runner registration token,
# never exported to the other commands.
#   organization target: resource owner = the org, organization permission "Self-hosted runners: Read and write"
#   repository target:   that repository only, repository permission "Administration: Read and write"
GITHUB_RUNNER_ADMIN_TOKEN=
